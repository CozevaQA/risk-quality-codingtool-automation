def ajax_preloader_wait(driver, timeout=300):
    """Wait until ajax preloaders and Drupal flash messages are gone."""
    time.sleep(1)
    WebDriverWait(driver, timeout).until(
        EC.invisibility_of_element((By.CLASS_NAME, CLASS_AJAX_PRELOADER))
    )
    if driver.find_elements(By.CLASS_NAME, CLASS_AJAX_PRELOADER):
        WebDriverWait(driver, timeout).until(
            EC.invisibility_of_element((By.CLASS_NAME, CLASS_AJAX_PRELOADER))
        )
    WebDriverWait(driver, timeout).until(
        EC.invisibility_of_element((By.CLASS_NAME, CLASS_DRUPAL_MSG))
    )
    time.sleep(1)


def wait_datatable(driver, timeout=30):
    """Wait for DataTables info footer (page ready signal)."""
    WebDriverWait(driver, timeout).until(
        EC.visibility_of_element_located((By.XPATH, XP_DATATABLES_INFO))
    )


def normalize(text):
    """Strip year ranges and normalize whitespace/case for fuzzy compare."""
    text = re.sub(r"\d+[-–]\d+", "", text)
    return " ".join(text.lower().split())


def get_status(searched_value, returned_result_array):
    """Return MATCHED if searched code appears in any returned suggestion."""
    if not searched_value or not returned_result_array:
        return "Empty Result Set"

    needle = str(searched_value).strip().lower()
    for item in returned_result_array:
        if needle in str(item).strip().lower():
            return "MATCHED"
    return "NO MATCHED"


def compare_flags(mspl_flag, dash_flag):
    """Compare MSPL vs Dashboard boolean flags → MATCHED / NOT MATCHED / NA."""
    if mspl_flag == 0 and dash_flag == 0:
        return "NA"
    if mspl_flag == dash_flag:
        return "MATCHED"
    return "NOT MATCHED"


def url_navigator(cust_id, base_url, main_url):
    """Rebuild registries URL with target customer id baked into session token."""
    parsed_url = urlparse(main_url)
    query_parameters = parse_qs(parsed_url.query)
    session_id = query_parameters.get("session", [None])[0]
    if not session_id:
        raise ValueError("No session parameter found in registry URL")

    decoded_val = base64.b64decode(session_id).decode("utf-8")
    # Session payload is anchored on customer 1500; swap in the target cust_id
    temp = decoded_val.replace("1500", str(cust_id))
    new_session = base64.b64encode(temp.encode("utf-8")).decode("utf-8")
    return f"{base_url}registries?session={new_session}"


def _cell_status_fill(value):
    """Pick a fill color based on cell text, or None if no rule matches."""
    if value is None:
        return None
    text = str(value).strip()
    text_lower = text.lower()

    if text in PASS_VALUES or any(p in text_lower for p in PASS_CONTAINS):
        return PatternFill("solid", fgColor=FILL_PASS)
    if text in FAIL_VALUES or any(f in text_lower for f in FAIL_VALUES):
        return PatternFill("solid", fgColor=FILL_FAIL)
    if text in NA_VALUES:
        return PatternFill("solid", fgColor=FILL_NA)
    return None


def format_excel_sheet(ws, wrap_columns=None, status_columns=None):
    """
    Apply header style, freeze pane, wrap selected columns, and color status cells.

    wrap_columns / status_columns: 1-based column index lists.
    Defaults apply wrap to common result columns and scan all cells for status colors
    so Navigation / MSPL / Code Search sheets all format correctly.
    """
    header_fill = PatternFill("solid", fgColor=FILL_HEADER)
    header_font = Font(bold=True)
    center_align = Alignment(vertical="center", wrap_text=True, horizontal="left")

    max_col = ws.max_column
    max_row = ws.max_row

    for col in range(1, max_col + 1):
        cell = ws.cell(row=1, column=col)
        cell.font = header_font
        cell.fill = header_fill
        cell.alignment = center_align
        ws.column_dimensions[get_column_letter(col)].width = 28

    # Default wrap columns: longer text fields (criteria, codes, comments, options)
    if wrap_columns is None:
        wrap_columns = [4, 5, 6, 7]

    for col in wrap_columns:
        if col <= max_col:
            for row in range(2, max_row + 1):
                ws.cell(row=row, column=col).alignment = Alignment(
                    wrap_text=True, vertical="top"
                )

    ws.freeze_panes = "A2"

    # Color status-like cells: either specific columns, or every data cell
    cols_to_scan = status_columns if status_columns else range(1, max_col + 1)
    for row in range(2, max_row + 1):
        for col in cols_to_scan:
            cell = ws.cell(row=row, column=col)
            fill = _cell_status_fill(cell.value)
            if fill:
                cell.fill = fill


def extract_code_list(populated_list):
    """
    Parse code <li> elements into (id_value_pairs, display_lines).
    id_value_pairs is a flat [id, tooltip, id, tooltip, ...] list (legacy shape).
    """
    code_id_value_list = []
    result_list = []
    for element in populated_list:
        div = element.find_element(By.TAG_NAME, "div")
        code_id = (div.get_attribute("id") or "").split("|")[0]
        code_value = div.get_attribute("data-tooltip")
        code_id_value_list.extend([code_id, code_value])
        result_list.append(f"{code_id} | {code_value}")
    return code_id_value_list, result_list


