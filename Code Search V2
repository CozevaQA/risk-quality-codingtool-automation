def measure_patient_finder(driver, customer, lob, measure_name, measure_abb,
                           domain_name, ws, wb):
    """
    Open measure → MSPL → first patient dashboard.
    Validates domain/name, pencil options, MAP, and MSPL↔Dashboard alignment.
    Returns 1 if supplemental data is available (code check should run), else 0.
    """
    name_check = "NA"
    domain_check = "NA"
    pencil_check = "NA"
    pencil_icon_details = "NA"
    perf_check = "NA"
    network_check = "NA"
    dashboard_map_check = "NA"
    dashboard_pencil_check = "NA"
    patient_link = "NA"
    comments = "NA"
    mspl_map_flag = 0
    mspl_supp_flag = 0
    dash_map_flag = 0
    dash_supp_flag = 0
    compliancy_details = "NA"
    mspl_link = ""

    try:
        # Resolve measure link (handle apostrophes in measure names)
        try:
            measure_link = driver.find_element(
                By.XPATH, xp_measure_link_by_name(measure_name)
            ).get_attribute("href")
        except Exception:
            # e.g. "Member's ..." → search on text after the apostrophe
            modified_text = measure_name.split("'", 1)[1]
            measure_link = driver.find_element(
                By.XPATH, xp_measure_link_by_span(modified_text)
            ).get_attribute("href")

        driver.get(measure_link)
        ajax_preloader_wait(driver)
        wait_datatable(driver)

        # Domain | Measure title on MSPL header
        measure_fullname = driver.find_element(By.XPATH, XP_MSPL_TITLE).text
        parts = measure_fullname.split("|")
        measure_domain_ui = parts[0].strip() if len(parts) > 0 else ""
        measure_name_ui = parts[1].strip() if len(parts) > 1 else ""

        print(f"Sheet domain: {domain_name} | UI domain: {measure_domain_ui}")
        name_check = (
            "Measure name successfully validated"
            if measure_name in measure_name_ui
            else "Measure name discrepancy found"
        )
        domain_check = (
            "Domain name successfully validated"
            if domain_name in measure_domain_ui
            else "Domain name discrepancy found"
        )

        try:
            # First provider's patient-list link
            elems = driver.find_element(
                By.XPATH, XP_PROVIDER_FIRST_LINK_CELL
            ).find_elements(By.TAG_NAME, "a")
            mspl_link = elems[0].get_attribute("href")
            driver.get(mspl_link)
            print("Opening MSPL...")
            ajax_preloader_wait(driver)
            wait_datatable(driver)

            rows = (
                driver.find_element(By.XPATH, XP_QUALITY_REGISTRY_LIST)
                .find_element(By.TAG_NAME, "tbody")
                .find_elements(By.TAG_NAME, "tr")
            )

            # If a filter tag blocks the table, close it and retry
            try:
                patient_link = rows[0].find_element(
                    By.XPATH, XP_PAT_NAME
                ).get_attribute("href")
            except Exception:
                driver.find_element(By.XPATH, XP_DT_TAG_CLOSE).click()
                ajax_preloader_wait(driver)
                wait_datatable(driver)
                rows = (
                    driver.find_element(By.XPATH, XP_QUALITY_REGISTRY_LIST)
                    .find_element(By.TAG_NAME, "tbody")
                    .find_elements(By.TAG_NAME, "tr")
                )
                patient_link = rows[0].find_element(
                    By.XPATH, XP_PAT_NAME
                ).get_attribute("href")

            tab_param = driver.find_element(
                By.XPATH, XP_QUALITY_REGISTRY_TABS
            ).find_elements(By.TAG_NAME, "li")
            if len(tab_param) > 2:
                perf_check = tab_param[1].text
                network_check = tab_param[2].text

            # Pencil / supplemental-data menu on first patient row
            try:
                print("Checking pencil icon availability...")
                rows[0].find_element(By.XPATH, XP_ADD_SUPP_TRIGGER).click()
                time.sleep(3)
                menu_items = rows[0].find_element(
                    By.XPATH, XP_ADD_SUPP_MENU
                ).find_elements(By.TAG_NAME, "li")
                pencil_check = "Pencil icon available"
                pencil_icon_details = ", ".join(d.text for d in menu_items)
            except Exception:
                pencil_check = "Pencil icon not available"
                pencil_icon_details = "Not applicable"

        except NoSuchElementException:
            print("No Providers Found, skipping check")
            comments = "No Providers Found for the measure"
            pencil_icon_details = "NA"
            patient_link = "NA"

    except Exception as e:
        print(f"Error in measure_patient_finder: {e}")
        traceback.print_exc()

    # --- Patient dashboard checks ---
    if patient_link == "NA":
        print("Skipping dashboard check (no patient link)...")
    else:
        driver.get(patient_link)
        ajax_preloader_wait(driver)
        measure_name_dashboard = measure_name.replace("'", "")

        try:
            driver.find_element(By.XPATH, xp_dashboard_pencil(measure_name_dashboard))
            dashboard_pencil_check = "Pencil icon available"
            dash_supp_flag = 1
        except NoSuchElementException:
            dashboard_pencil_check = "Pencil icon not available"

        try:
            driver.find_element(By.XPATH, xp_dashboard_map(measure_name_dashboard))
            dashboard_map_check = "MAP checkbox available"
            dash_map_flag = 1
        except NoSuchElementException:
            dashboard_map_check = "MAP checkbox not available"

        try:
            driver.find_element(By.XPATH, xp_dashboard_non_compliant(measure_name))
            compliancy_details = "Non-compliant"
        except NoSuchElementException:
            compliancy_details = "Compliant"

    # --- Align MSPL pencil options with dashboard ---
    if "Add Supplemental Data" in pencil_icon_details:
        mspl_supp_flag = 1
    else:
        comments = f"{comments}| No supplemental data, skipping code check"

    if "Mark as Pending" in pencil_icon_details:
        mspl_map_flag = 1

    mspl_dashboard_map_check = compare_flags(mspl_map_flag, dash_map_flag)
    mspl_dashboard_pencil_check = compare_flags(mspl_supp_flag, dash_supp_flag)

    # Navigation sheet row
    ws.append([
        customer, lob, domain_check, name_check,
        perf_check, network_check, comments
    ])
    format_excel_sheet(
        ws,
        wrap_columns=[7],
        status_columns=[3, 4],
    )

    # MSPL vs Dashboard sheet row
    ws_mspl = wb["MSPL vs Dashboard Check"]
    ws_mspl.append([
        customer, lob, compliancy_details, pencil_check, pencil_icon_details,
        dashboard_pencil_check, dashboard_map_check,
        mspl_dashboard_map_check, mspl_dashboard_pencil_check, mspl_link
    ])
    format_excel_sheet(
        ws_mspl,
        wrap_columns=[5, 10],
        status_columns=[3, 4, 6, 7, 8, 9],
    )
    return mspl_supp_flag


