def code_search_coding_tool(driver, customer, lob, measure_name, ws):
    """
    Match the target metric, then for each criteria option:
      - click every advanced-search button present for that criteria
      - populate codes, search the first code id, record MATCHED / NO MATCHED
    """
    cz_id = driver.find_element(By.XPATH, XP_PATIENT_COZEVA_ID).text
    time.sleep(2)

    metric_rows = driver.find_elements(By.XPATH, XP_METRIC_ROWS)
    target_metric = None

    # --- Locate metric by name (relative XPath scoped to each row) ---
    try:
        print("Finding matching metric...")
        for metric in metric_rows:
            try:
                metric_name = metric.find_element(
                    By.XPATH, XP_MET_NAME_REL
                ).text.strip()
                if measure_name == metric_name:
                    target_metric = metric
                    print(f"Matched metric: {metric_name}")
                    driver.execute_script(
                        "arguments[0].scrollIntoView({block:'center'});",
                        target_metric,
                    )
                    driver.find_element(By.XPATH, XP_RIGHT_PANEL_FIRST_TAB).click()
                    time.sleep(1)
                    target_metric.find_element(By.XPATH, XP_ADD_MORE_REL).click()
                    time.sleep(2)
                    break
            except Exception as inner_e:
                print(f"Skipping metric due to error: {inner_e}")
    except Exception as e:
        print(f"Error occurred at metric match: {e}")
        return

    if not target_metric:
        print("Target metric not found")
        return

    # --- Criteria loop ---
    choices = driver.find_elements(By.XPATH, XP_CHOICE_OPTIONS_LI)
    print("Executing code search...")

    for i in range(len(choices)):
        driver.find_element(By.XPATH, XP_CHOICE_SELECT_WRAPPER).click()
        time.sleep(2)
        # Re-query after dropdown re-render
        choices = driver.find_elements(By.XPATH, XP_CHOICE_OPTIONS_LI)
        criteria = choices[i].text
        print(f"Checking Criteria {i + 1}: {criteria}")
        choices[i].click()
        time.sleep(3)

        try:
            # All advanced-search buttons for this criteria (multi-code-set support)
            adv_buttons = driver.find_elements(By.XPATH, XP_ADVANCED_SEARCH_BTN)
            if not adv_buttons:
                raise NoSuchElementException("No advanced search buttons found")

            print(f"Found {len(adv_buttons)} advanced search button(s)")
            for btn in adv_buttons:
                btn.click()
                populated_list = driver.find_elements(By.XPATH, XP_CODE_UL_LI)

                try:
                    code_id_value_list, result_lines = extract_code_list(
                        populated_list
                    )
                    result_list = "\n ".join(result_lines)

                    # Search using the first populated code id
                    search_input = driver.find_element(
                        By.ID, "advanced_code_search_input"
                    )
                    search_input.clear()
                    search_input.send_keys(code_id_value_list[0])
                    time.sleep(5)

                    populated_list = driver.find_elements(By.XPATH, XP_CODE_UL_LI)
                    search_results = []
                    try:
                        _, search_results = extract_code_list(populated_list)
                        populated_result = "\n ".join(search_results)
                    except NoSuchElementException:
                        populated_result = (
                            "No Suggestions found for the searched code: "
                            + str(code_id_value_list[0])
                        )

                    status = get_status(code_id_value_list[0], search_results)
                    try:
                        print("\n ".join(search_results))
                        # Report the code that was searched
                        populated_result = (
                            f"{code_id_value_list[0]} | {code_id_value_list[1]}"
                        )
                    except (TypeError, IndexError):
                        populated_result = (
                            "Check the result. At least one item empty."
                        )

                except NoSuchElementException:
                    result_list = "No suggestions found"
                    populated_result = "NA"
                    status = "NA"

                ws.append([
                    customer, lob, cz_id, measure_name, criteria,
                    result_list, populated_result, status,
                ])
                format_excel_sheet(ws, wrap_columns=[6, 7], status_columns=[8])

                driver.find_element(By.XPATH, XP_ASF_CLEAR).click()
                time.sleep(1)

        except Exception as e:
            print(e)
            print("No codes to populate...")
            ws.append([
                customer, lob, cz_id, measure_name, criteria,
                "No codes for criteria", "NA", "NA",
            ])
            format_excel_sheet(ws, wrap_columns=[6, 7], status_columns=[8])
            continue

        time.sleep(1)


def close_coding_tool(driver):
    """Discard the coding-tool task after code search completes."""
    driver.find_element(By.XPATH, XP_CHART_ACTION_DELETE).click()
    WebDriverWait(driver, 30).until(
        EC.visibility_of_element_located((By.XPATH, XP_COZEVA_PROMPT))
    )
    time.sleep(1)
    driver.find_element(By.XPATH, XP_TASK_DELETE_INPUT).send_keys("CozevaQA")
    driver.find_element(By.XPATH, XP_PROMPT_CONFIRM).click()
    time.sleep(1)
    ajax_preloader_wait(driver)


def apply_registry_filters(driver, lob, measure_year):
    """Set MY year + LOB on registries filter panel and apply."""
    driver.find_element(By.XPATH, XP_QT_FILTER_LABEL).click()
    time.sleep(1)

    for year in driver.find_element(
        By.XPATH, XP_FILTER_QUARTER
    ).find_elements(By.TAG_NAME, "li"):
        if measure_year in year.text:
            year.click()
            break

    for lob_item in driver.find_element(
        By.XPATH, XP_FILTER_LOB
    ).find_elements(By.TAG_NAME, "li"):
        if "All" in lob:
            if lob in lob_item.text:
                lob_item.click()
                break
        elif lob == lob_item.text:
            lob_item.click()
            break

    time.sleep(1)
    driver.find_element(By.XPATH, XP_REG_FILTER_APPLY).click()
    ajax_preloader_wait(driver)


def ensure_ce_off(driver):
    """Turn Continuous Enrollment off if currently selected."""
    if driver.find_element(By.XPATH, XP_CONTI_ENROLL).is_selected():
        print("CE toggled on, switching off")
        driver.find_element(By.XPATH, XP_CONT_DISC_TOGGLE).click()
    else:
        print("CE Off")


def close_active_filter_indicator(driver):
    """Close pre-applied filter chip on registry if present."""
    try:
        filter_indicator = WebDriverWait(driver, 5).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, CSS_FILTER_INDICATOR))
        )
        filter_indicator.find_element(By.CSS_SELECTOR, CSS_FILTER_CLOSE).click()
        print("Filter was applied..Closing it")
    except Exception:
        print("No active filter indicator found")


